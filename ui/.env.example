# Example environment variables for local/remote deployment
# Copy to `.env` and fill values (do NOT commit secrets)

# Gradio app
PORT=7860

# OpenAI key used by KnowledgeBase and other modules
OPENAI_API_KEY=

# Weaviate URL: when using local weaviate service in docker-compose use the service name
WEAVIATE_URL=http://weaviate:8080

# Port on remote host to expose the Gradio app (external port -> container 7860)
DEPLOY_PORT=80

# Recherche web (Tavily)
TAVILY_API_KEY=
